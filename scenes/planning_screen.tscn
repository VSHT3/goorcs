[node name="Feedback" type="Label" parent="Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 38)
layout_mode = 2
theme_override_colors/font_color = Color(0.80, 0.77, 0.67, 1)
theme_override_font_sizes/font_size = 14
text = "Edges connect; corners do not. Every tile must reach the entrance. Edits clear your ready state.\nFree Arrow placement · No economy · All combat numbers are provisional playtest settings."
autowrap_mode = 2
