[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/planning_screen.gd" id="1_planning"]
[ext_resource type="Script" path="res://scripts/path_board.gd" id="2_board"]

[node name="PlanningScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
size_flags_horizontal = 3
size_flags_vertical = 3
script = ExtResource("1_planning")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 6

[node name="Status" type="Label" parent="Content"]
