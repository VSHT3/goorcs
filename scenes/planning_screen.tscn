[node name="TowerMenu" type="OptionButton" parent="Content/Tools"]
unique_name_in_owner = true
custom_minimum_size = Vector2(150, 38)
layout_mode = 2
tooltip_text = "Select a tower to place, or None to inspect and edit paths during breaks."

[node name="TargetLabel" type="Label" parent="Content/Tools"]
layout_mode = 2
visible = false
