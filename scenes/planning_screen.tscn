[node name="Actions" type="HBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Clear" type="Button" parent="Content/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(156, 38)
layout_mode = 2
