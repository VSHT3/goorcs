[node name="Ready" type="Button" parent="Content/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(156, 38)
layout_mode = 2
text = "Ready for wave 1"

[node name="Controls" type="Label" parent="Content/Actions"]
unique_name_in_owner = true
layout_mode = 2
