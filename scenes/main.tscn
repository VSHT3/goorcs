[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/main.gd" id="1_main"]
[ext_resource type="Script" path="res://scripts/path_board.gd" id="2_board"]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_main")

[node name="Margin" type="MarginContainer" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 24

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="Margin/Content"]
layout_mode = 2

[node name="Title" type="Label" parent="Margin/Content/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.90, 0.88, 0.81, 1)
theme_override_font_sizes/font_size = 32
text = "Workshop"

[node name="Menu" type="Button" parent="Margin/Content/Header"]
custom_minimum_size = Vector2(100, 0)
layout_mode = 2
text = "Menu"
tooltip_text = "Return to the menu (Esc)."

[node name="Workspace" type="HBoxContainer" parent="Margin/Content"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 24

[node name="Board" type="Control" parent="Margin/Content/Workspace"]
custom_minimum_size = Vector2(560, 360)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
mouse_default_cursor_shape = 2
tooltip_text = "Left drag: place. Right drag: erase.\nE: entrance · B: base."
script = ExtResource("2_board")

[node name="Sidebar" type="VBoxContainer" parent="Margin/Content/Workspace"]
custom_minimum_size = Vector2(220, 0)
layout_mode = 2
theme_override_constants/separation = 10

[node name="Status" type="Label" parent="Margin/Content/Workspace/Sidebar"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
tooltip_text = "The base and every placed tile must connect to the entrance."

[node name="Budget" type="Label" parent="Margin/Content/Workspace/Sidebar"]
layout_mode = 2
theme_override_font_sizes/font_size = 26

[node name="Route" type="Label" parent="Margin/Content/Workspace/Sidebar"]
layout_mode = 2
theme_override_font_sizes/font_size = 16

[node name="Spacer" type="Control" parent="Margin/Content/Workspace/Sidebar"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2

[node name="Clear" type="Button" parent="Margin/Content/Workspace/Sidebar"]
custom_minimum_size = Vector2(0, 42)
layout_mode = 2
text = "Clear tiles"
tooltip_text = "Remove placed paths. Entrance and base stay fixed."

[node name="Feedback" type="Label" parent="Margin/Content"]
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(0.80, 0.77, 0.67, 1)
autowrap_mode = 2

[node name="FeedbackTimer" type="Timer" parent="."]
wait_time = 3.5
one_shot = true

[node name="Menu" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Center" type="CenterContainer" parent="Menu"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="VBoxContainer" parent="Menu/Center"]
custom_minimum_size = Vector2(500, 0)
layout_mode = 2
theme_override_constants/separation = 20

[node name="Title" type="Label" parent="Menu/Center/Panel"]
layout_mode = 2
theme_override_colors/font_color = Color(0.90, 0.88, 0.81, 1)
theme_override_font_sizes/font_size = 64
text = "GORCS"

[node name="Play" type="Button" parent="Menu/Center/Panel"]
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Play"
tooltip_text = "Host or join a two-player match."

[node name="Open" type="Button" parent="Menu/Center/Panel"]
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Workshop"
tooltip_text = "Edit a local maze. The layout lasts until you quit."

[node name="Collection" type="Button" parent="Menu/Center/Panel"]
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Collection"
tooltip_text = "View tower unlocks and open chests."

[node name="Quit" type="Button" parent="Menu/Center/Panel"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
text = "Quit"

