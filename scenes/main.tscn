[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/main.gd" id="1_main"]
[ext_resource type="Script" path="res://scripts/path_board.gd" id="2_board"]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_main")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 24

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.90, 0.88, 0.81, 1)
theme_override_font_sizes/font_size = 32
text = "GOORCS / Path workshop"

[node name="Subtitle" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.70, 0.65, 1)
text = "Draw the maze. Inspect the shortcuts.   •   Local prototype — no combat or multiplayer"

[node name="Workspace" type="HBoxContainer" parent="Margin/Content"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 24

[node name="Board" type="Control" parent="Margin/Content/Workspace"]
custom_minimum_size = Vector2(560, 360)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
mouse_default_cursor_shape = 2
script = ExtResource("2_board")

[node name="Sidebar" type="VBoxContainer" parent="Margin/Content/Workspace"]
custom_minimum_size = Vector2(300, 0)
layout_mode = 2
theme_override_constants/separation = 10

[node name="Status" type="Label" parent="Margin/Content/Workspace/Sidebar"]
layout_mode = 2
theme_override_font_sizes/font_size = 18

[node name="Budget" type="Label" parent="Margin/Content/Workspace/Sidebar"]
layout_mode = 2
theme_override_font_sizes/font_size = 16

[node name="Route" type="Label" parent="Margin/Content/Workspace/Sidebar"]
layout_mode = 2
theme_override_font_sizes/font_size = 16

[node name="Legend" type="Label" parent="Margin/Content/Workspace/Sidebar"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "E   Entrance\nB   Base / crystal\nGreen line   Shortest route\nStone tiles   Branches / unused route"

[node name="Rules" type="Label" parent="Margin/Content/Workspace/Sidebar"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Edges connect; corners do not.\nAdjacent tiles can create shortcuts.\nPlacement order does not set the route."

[node name="Spacer" type="Control" parent="Margin/Content/Workspace/Sidebar"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2

[node name="Clear" type="Button" parent="Margin/Content/Workspace/Sidebar"]
custom_minimum_size = Vector2(0, 42)
layout_mode = 2
text = "Clear placed tiles"

[node name="Settings" type="Label" parent="Margin/Content/Workspace/Sidebar"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.70, 0.65, 1)
theme_override_font_sizes/font_size = 13

[node name="Controls" type="Label" parent="Margin/Content"]
layout_mode = 2
text = "LEFT CLICK / DRAG   Place tiles       RIGHT CLICK / DRAG   Remove tiles"

[node name="Feedback" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.80, 0.77, 0.67, 1)
autowrap_mode = 2
