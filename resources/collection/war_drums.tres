[resource]
script = ExtResource("1_reward")
id = &"war_drums"
title = "War Drums"
description = "Paired war drums strengthen nearby attackers. Choose one permanent specialty: Forge damage, Command Banner attack speed, Lookout Horn range or Bloodlust Totem critical hits. Only the Horn expands its aura; the strongest nearby bonus of each kind applies."
