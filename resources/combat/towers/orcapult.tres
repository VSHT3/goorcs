damage_upgrade_bonus = 4
speed_upgrade_multiplier = 0.8
attack_sound = 1
behavior_kind = "catapult"
; lift is the heaviest enemy health multiplier the arm can grab (Grunt 1.0).
; landing_progress is in route cells on the opponent's path; haste multiplies
; the landed enemy's speed. Bosses and already-thrown enemies are never grabbed.
