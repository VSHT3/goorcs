[ext_resource type="Resource" path="res://resources/collection/lightning.tres" id="2_reward"]

[resource]
script = ExtResource("1_definition")
reward = ExtResource("2_reward")
; Provisional playtest balance, not creator-approved final stats or identity.
damage = 3
range_cells = 3.0
interval = 1.1
cost = 100
upgrade_base_cost = 60
damage_upgrade_bonus = 2
speed_upgrade_multiplier = 0.8
attack_sound = 2
behavior_kind = "chain"
; hit_count includes the initial target. Every subsequent target is nearest unhit.
behavior_config = {"hit_count": 3, "jump_distance": 2.0, "successive_hit_bonus": 0.0}
roll_attributes = PackedStringArray("damage", "attack_speed", "range", "chain_jumps")
special_upgrade = "escalating_chain"
special_upgrade_title = "Escalating Chain"
special_upgrade_cost = 250
; Zero-based hit i receives base damage * (1 + i * successive_hit_bonus).
special_upgrade_config = {"successive_hit_bonus": 0.25}
; The only current evolution direction; requires the shared special first.
; Preserve purchased escalation and rolled modifiers when applying base config.
evolutions = {
"longer_reach": {
"title": "Longer Reach",
"cost": 500,
"behavior_kind": "chain",
"range_cells": 5.0,
"behavior_config": {"hit_count": 3, "jump_distance": 3.5, "successive_hit_bonus": 0.0}
}
}
