[resource]
script = ExtResource("1")
id = &"the_whole_shebang_orcfeccion"
title = "The Whole She BangBang"
rarity = 6
effect_text = "The Whole Shebang's historical branch slots now grow to +115% attack rate, preserving completion and all accrued bonuses."
icon_texture = ExtResource("2")
detail_texture = ExtResource("3")
mechanics = PackedStringArray("Keep The Whole Shebang's historical checklist of every reachable terminal upgrade branch in the equipped loadout. The first tower to reach each end node registers that branch's one tower slot.", "Activate after every reachable end node has been completed at least once. Only each slot's registered tower receives the bonus; duplicate maxed towers do not receive additional slots.", "After activation, each occupied slot gains +1 percentage point of attack rate per actual cleared wave that its registered tower survives, now up to +115% attack rate.", "There is no retroactive growth before activation. Skipping displayed round numbers does not grant extra stacks.", "Selling a registered tower never resets historical completion or its slot's accrued bonus. Empty slots pause growth; the next tower to reach the same terminal branch inherits its accrued bonus and resumes growth.", "Upgrading from The Whole Shebang changes only the cap from +85% to +115%. Preserve all historical completion, registered branch slots, and accrued bonuses without any counter reset or other stat change.")
acquisition_text = "The Whole She BangBang is upgrade-only: upgrade The Whole Shebang for a base price of 10,000 Coins. Never available from random drops or Monkey’s Paw."
